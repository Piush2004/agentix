# Postgres connection string for the Python backend's own database
# (users, datasets, workflow runs, pipeline stages).
DATABASE_URL=postgresql://user:password@host:5432/agentix

# Only needed if a background job runner actually depends on it - the
# current pipeline executes via FastAPI BackgroundTasks in-process, not
# RQ/Celery, so confirm this is actually required before provisioning it.
REDIS_URL=

# Comma-separated list of origins allowed to call this API. Must include
# your deployed frontend's real URL, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Enables real Sentry error tracking; left unset, Sentry silently
# no-ops instead of using a fake placeholder DSN.
SENTRY_DSN=

# Optional. Enables a cloud Gemini fallback for AI chat/insights when no
# local Ollama model is reachable (cloud-hosted backends can't reach a
# laptop's localhost Ollama instance). Not yet wired to an actual Gemini
# call in code - only the provider-selection logic reads this.
GEMINI_API_KEY=

# Set by the hosting platform (Railway/Render) automatically at runtime;
# the Dockerfile's CMD reads this to bind to the right port. No action
# needed unless running outside Docker.
PORT=8000
